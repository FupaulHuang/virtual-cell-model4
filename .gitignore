# Default deny. Publish only reviewed source and human-readable documentation.
/*
!/.gitignore
!/.githooks/
!/.githooks/pre-commit
!/README.md
!/PUBLICATION.md
!/THIRD_PARTY_NOTICES.md
!/PLAN.md
!/EXPERIMENT_PLAN.md
!/SUBMISSION_PLAN.md
!/requirements.txt
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.sh
!/tests/
/tests/*
!/tests/*.py
!/configs/
/configs/*
!/configs/*.json
!/docs/
/docs/*
!/docs/*.md
!/reports/
/reports/*
!/reports/*.md
!/reports/upstream_sources.json
!/research/
/research/*
!/research/*.md
!/external/
/external/*
!/external/atlasshift/
/external/atlasshift/*
!/external/atlasshift/*.py
!/external/atlasshift/README.md
!/external/atlasshift/requirements.txt
!/external/atlasshift/sources.json
!/external/atlasshift/LICENSE
**/__pycache__/
**/*.pyc
**/.env*
**/*.h5ad
**/*.h5
**/*.hdf5
**/*.npz
**/*.npy
**/*.parquet
**/*.vcc
**/*.pt
**/*.pth
**/*.pkl
**/*.pickle
**/*.zip
**/*.tar*
**/*.curl
**/*.headers
**/*.log
**/*.pem
**/*.key
